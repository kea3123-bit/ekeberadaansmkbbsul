Options -Indexes
<FilesMatch "^(?:config\.local(?:\.example)?\.php|_lib\.php|cli_set_pin\.php|cli_check_db\.php|schema\.sql|README\.md)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
