Options -Indexes
<FilesMatch "^(?:config\.local.*|_lib\.php|workspace_(?:bridge|services)\.php|(?:email_queue|mail_schedule|pin_recovery|admin_maintenance)\.php|cli_(?:set_pin|check_db)\.php|schema\.sql|README\.md|error_log(?:[._-].*)?|.*\.(?:sql|log|env|bak|zip|old|save|swp))$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
